+/// A ring of lines of 16 words from one worker to another.
+struct Ring {
+    tail: Pad,
+    head: Pad,
+    lines: Box<[[AtomicU64; 8]]>,
+}
+
+#[repr(align(64))]
+struct Pad(AtomicUsize);
+
+const LINES: usize = 64;
+
+/// The mask updates between the workers. Worker `o` owns the masks of positions `p` with `owner(p) == o` and is the only one to
+/// write them, so they need no locked instruction. Every other worker sends it `p << 8 | country` through the ring (s, o).
+struct Post {
+    workers: usize,
+    shift: u32,
+    rings: Vec<Ring>,
+    done: AtomicUsize,
+}
+
+impl Post {
+    fn new(workers: usize, bits: u32) -> Post {
+        let ring = || Ring { tail: Pad(AtomicUsize::new(0)), head: Pad(AtomicUsize::new(0)), lines: (0..LINES).map(|_| Default::default()).collect() };
+        Post { workers, shift: bits - 2, rings: (0..workers * workers).map(|_| ring()).collect(), done: AtomicUsize::new(0) }
+    }
+
+    /// The worker that owns the mask of position `p`: positions in ranges, two to a cache line.
+    fn owner(&self, p: usize) -> usize {
+        ((p >> 1) * self.workers) >> self.shift
+    }
+
+    /// Sends a line of 16 words from worker `me` to worker `o`; while the ring is full, applies what others sent to `me`.
+    fn send(&self, me: usize, o: usize, line: &[u64; 8], names: &Names) {
+        let r = &self.rings[me * self.workers + o];
+        let t = r.tail.0.load(Relaxed);
+        while t - r.head.0.load(Acquire) == LINES {
+            (self.drain(me, names), std::hint::spin_loop());
+        }
+        (0..8).for_each(|k| r.lines[t % LINES][k].store(line[k], Relaxed));
+        r.tail.0.store(t + 1, Release);
+    }
+
+    /// Applies to the masks of worker `me` every word sent to it so far.
+    fn drain(&self, me: usize, names: &Names) {
+        for s in 0..self.workers {
+            let r = &self.rings[s * self.workers + me];
+            let (h, t) = (r.head.0.load(Relaxed), r.tail.0.load(Acquire));
